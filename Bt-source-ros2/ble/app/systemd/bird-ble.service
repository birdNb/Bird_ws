[Unit]
Description=Bird BLE GATT Remote Control (BT_Control_0717)
Documentation=file://@PKG_DIR@/docs/BLE_PROTOCOL.md
# 先等量产栈服务单元启动；进程级就绪由 bird-ble-boot.sh 硬等待 midware/controller
After=bluetooth.service network-online.target ros2-bringup.service
Wants=bluetooth.service network-online.target ros2-bringup.service
Requires=bluetooth.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@BT_DIR@
Environment=ROS_DISTRO=foxy
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file://@BIRD_HOME@/.config/bird/cyclonedds.runtime.xml
Environment=COLCON_WS=@COLCON_WS@
Environment=PKG_DIR=@PKG_DIR@
Environment=BT_DIR=@BT_DIR@
Environment=BIRD_WS=@BIRD_WS@
Environment=BIRD_USER=@BIRD_USER@
Environment=BIRD_HOME=@BIRD_HOME@
Environment=PULSE_SERVER=unix:/run/user/@BIRD_BLE_UID@/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/@BIRD_BLE_UID@
Environment=HOME=@BIRD_HOME@
Environment=BLE_DEVICE_NAME_FILE=/var/lib/bird-ble/ble_device_name.conf
Environment=ROS2_WAIT_SEC=300
# 低于量产栈，避免抢 CPU
Nice=5
CPUWeight=50
ExecStart=@BT_DIR@/systemd/bird-ble-boot.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bird-ble

[Install]
WantedBy=multi-user.target
