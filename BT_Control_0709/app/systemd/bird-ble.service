[Unit]
Description=Bird BLE GATT Remote Control (BT_test)
Documentation=file://@PKG_DIR@/docs/BLE_PROTOCOL.md
After=bluetooth.service network-online.target
Wants=bluetooth.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@BT_DIR@
Environment=ROS_DISTRO=noetic
Environment=PKG_DIR=@PKG_DIR@
Environment=BT_DIR=@BT_DIR@
Environment=BIRD_WS=@BIRD_WS@
Environment=BIRD_USER=@BIRD_USER@
Environment=BIRD_HOME=@BIRD_HOME@
Environment=PULSE_SERVER=unix:/run/user/@BIRD_BLE_UID@/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/@BIRD_BLE_UID@
Environment=HOME=@BIRD_HOME@
ExecStartPre=/bin/sleep 3
ExecStart=@BT_DIR@/systemd/bird-ble-boot.sh
Restart=always
RestartSec=8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bird-ble

[Install]
WantedBy=multi-user.target
