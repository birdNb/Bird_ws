[Unit]
Description=Bird BLE GATT Remote Control (BT_test)
Documentation=file:///home/nvidia/Bird_ws/BT_test/BLE_PROTOCOL.md
After=bluetooth.service network-online.target
Wants=bluetooth.service
# 给蓝牙固件/驱动一点就绪时间
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/nvidia/Bird_ws/BT_test
Environment=ROS_DISTRO=noetic
Environment=BIRD_WS=/home/nvidia/Bird_ws
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/1000
# 与手动 sudo -E ./start.sh 一致，避免 expanduser/~/.local 落到 /root
Environment=HOME=/home/nvidia
ExecStartPre=/bin/sleep 3
ExecStart=/home/nvidia/Bird_ws/BT_test/systemd/bird-ble-boot.sh
Restart=always
RestartSec=8

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bird-ble

[Install]
WantedBy=multi-user.target
