@PACKAGE_INIT@

# 查找依赖项
find_package(Boost REQUIRED COMPONENTS chrono thread)
find_package(serial_cmake REQUIRED)
find_package(yaml-cpp REQUIRED)
find_package(lcm REQUIRED)

find_library(SERIALPORT_LIBRARY serialport)
if(NOT SERIALPORT_LIBRARY)
  message(FATAL_ERROR "libserialport not found")
endif()

# 包含导出的目标
include("${CMAKE_CURRENT_LIST_DIR}/yesense_imuTargets.cmake")

# 设置包含目录
set(yesense_imu_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")

check_required_components(yesense_imu)
