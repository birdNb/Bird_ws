[Unit]
Description=Robot Control Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%ROBOT_DIR%
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=%ROS_PYTHON_PATH%"
Environment="ROS_MASTER_URI=http://localhost:11311"
Environment="ROS_HOSTNAME=localhost"

# 启动命令
ExecStart=%PYTHON_CMD% %ROBOT_DIR%/robot/robot_main.py

# 重启策略
Restart=always
RestartSec=10

# 日志
StandardOutput=append:%ROBOT_DIR%/robot.log
StandardError=append:%ROBOT_DIR%/robot.log

[Install]
WantedBy=default.target
